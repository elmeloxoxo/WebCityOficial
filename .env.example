# ---------------------------------------------------------------------------
# WebCity — variables de entorno
# Copia este archivo como `.env.local` y completa los valores reales.
# ---------------------------------------------------------------------------

# URL pública del sitio (sin barra final). Se usa para SEO, sitemap y datos
# estructurados. En local puedes dejarla vacía: se usará http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://webcity.pe

# ---------------------------------------------------------------------------
# Envío del formulario de contacto (opcional)
# ---------------------------------------------------------------------------
# Si defines RESEND_API_KEY, los mensajes del formulario se envían por correo
# con Resend. Si no la defines, el formulario funciona igual: guarda el mensaje
# en .data/contactos.jsonl y lo registra en la consola del servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hola@webcity.pe
# Remitente verificado en Resend (debe pertenecer a un dominio validado).
CONTACT_FROM_EMAIL=WebCity <formulario@webcity.pe>
